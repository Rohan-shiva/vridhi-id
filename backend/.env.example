# Vridhi-ID Backend Environment Configuration
# Node environment (development, production, test)
NODE_ENV=development
PORT=5000

# Client origin for CORS
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Real URI e.g. mongodb://localhost:27017/vridhi_id or Atlas)
# If MongoDB is unavailable in local dev, backend automatically runs embedded memory engine.
MONGODB_URI=mongodb://localhost:27017/vridhi_id

# JWT Configuration (Minimum 32 characters, required in production)
JWT_SECRET=super_secret_vridhi_jwt_signing_key_at_least_32_chars_long
JWT_EXPIRES_IN=24h

# Microservice URL for AI Biometric Model Service
MODEL_SERVICE_URL=http://localhost:8000

# OTP & SMS Gateway Configuration
# In production, integrate SMS provider (e.g. CDAC / NIC SMS Gateway, Twilio, Fast2SMS)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=VRIDHI

# Explicit Test Mode Configuration
# When set to true in development, OTP is returned in response for automated testing.
# In production, this flag is strictly ignored and must be false.
OTP_TEST_MODE=true

# Initial Officer Account Seed (Created on startup if non-existent)
INITIAL_OFFICER_MOBILE=9876543210
INITIAL_OFFICER_NAME=Senior Verification Officer
